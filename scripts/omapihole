#!/usr/bin/env python3
"""OmaPihole helper: the only process that talks to Pi-hole.

QML never sees a SID or the app password. This script reads a mode-600
password file, keeps a SID under ~/.local/state/omapihole/, and prints one
JSON object to stdout. Exit 0 on logical errors (ok: false). Non-zero only
for usage errors.
"""

from __future__ import annotations

import fcntl
import json
import math
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse

USER_AGENT = "omapihole/0.3"
CONNECT_TIMEOUT = "3"
MAX_TIME = "8"
MAX_SECRET_BYTES = 8192
# Pi-hole answers are a few kB; anything far larger is not a Pi-hole.
MAX_RESPONSE_BYTES = 1000000
MAX_TEXT_CHARS = 200
MAX_HISTORY_ROWS = 300
MAX_DOMAINS = 10
# FTL session IDs are short base64; anything else is not stored or sent.
SID_RE = re.compile(r"^[A-Za-z0-9+/=_.-]{1,256}$")
TWO_FA_MSG = "this Pi-hole has 2FA; use an app password, not the web password."
DEFAULT_PASSWORD_FILE = "~/.config/omapihole/password"
USAGE = "usage: omapihole status [--bar] | pause <seconds> | resume | allow <domain> | ping"
ALLOW_COMMENT = "Allowed from OmaPihole"
DOMAIN_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?)(\.[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?)*$")


class HelperError(Exception):
    def __init__(self, state, error, extra=None):
        self.state = state
        self.error = error
        self.extra = extra or {}
        super().__init__(error)


class AuthError(HelperError):
    def __init__(self, error):
        super().__init__("auth", error)


class OfflineError(HelperError):
    def __init__(self, error):
        super().__init__("offline", error)


class FailedError(HelperError):
    def __init__(self, error, extra=None):
        super().__init__("failed", error, extra)


def rate_limited(payload):
    # 429 means too many logins or no free API seats. Neither is fixed by
    # editing credentials, so report it as a retryable failure rather than
    # "auth", which would put the panel back into setup.
    hint = error_hint(payload)
    message = "Pi-hole is rate-limiting: %s" % hint if hint else "Pi-hole is rate-limiting requests"
    # The widget backs off on this flag instead of polling into the limit.
    return FailedError(message, {"rate_limited": True})


# Tests replace this. Production talks to curl.
def http_exchange(method, url, headers, body, insecure, ca_file=None):
    """Return (status:int|None, text:str, error:str|None).

    status is None on a transport failure (timeout, TLS, refused).
    """
    cmd = [
        "curl",
        "-sS",
        "-X",
        method,
        "--connect-timeout",
        CONNECT_TIMEOUT,
        "--max-time",
        MAX_TIME,
        "--proto",
        "=http,https",
        "--max-filesize",
        str(MAX_RESPONSE_BYTES),
        "-w",
        "\n%{http_code}",
    ]
    if insecure:
        cmd.append("-k")
    elif ca_file:
        cmd.extend(["--cacert", ca_file])
    header_lines = ["%s: %s" % (key, value) for key, value in headers.items()]
    if body is not None:
        header_lines.append("Content-Type: application/json")
        payload = body if isinstance(body, str) else json.dumps(body)
        cmd.extend(["--data-binary", "@-"])
    else:
        payload = None

    # Headers carry the SID. curl's argv is readable by every local user in
    # /proc/<pid>/cmdline, so hand the headers over on a pipe instead. The
    # blob is far below the pipe buffer, so writing it up front cannot block.
    try:
        read_fd, write_fd = os.pipe()
    except OSError as exc:
        return None, "", str(exc)
    try:
        try:
            os.write(write_fd, ("\n".join(header_lines) + "\n").encode("utf-8"))
        finally:
            os.close(write_fd)
        cmd.extend(["-H", "@/dev/fd/%d" % read_fd, url])
        proc = subprocess.run(
            cmd, capture_output=True, text=True, input=payload, pass_fds=(read_fd,), check=False
        )
    except FileNotFoundError:
        return None, "", "curl not found"
    except OSError as exc:
        return None, "", str(exc)
    finally:
        os.close(read_fd)

    stdout = proc.stdout or ""
    stderr = (proc.stderr or "").strip()
    if len(stdout) > MAX_RESPONSE_BYTES + 16:
        return None, "", "response too large"
    body_text, sep, code_s = stdout.rpartition("\n")
    if not sep:
        body_text, code_s = "", stdout.strip()

    status = None
    if code_s.isdigit():
        status = int(code_s)
        if status == 0:
            status = None

    if status is None:
        return None, body_text, classify_curl(proc.returncode, stderr)

    return status, body_text, None


def classify_curl(returncode, stderr):
    if returncode == 28:
        return "connection timed out"
    if returncode in (51, 60):
        return "TLS verification failed"
    if returncode == 7:
        return "connection refused"
    if returncode == 63:
        return "response too large"
    if returncode == 1:
        return "URL must start with http:// or https://"
    if stderr:
        return stderr
    if returncode:
        return "unreachable (curl exit %d)" % returncode
    return "unreachable"


def now_unix():
    return int(time.time())


def state_dir(env):
    home = env.get("HOME") or os.path.expanduser("~")
    xdg = env.get("XDG_STATE_HOME") or os.path.join(home, ".local", "state")
    return os.path.join(xdg, "omapihole")


def session_path(env):
    return os.path.join(state_dir(env), "session")


def lock_path(env):
    return os.path.join(state_dir(env), "lock")


def expand_path(path):
    return os.path.abspath(os.path.expanduser(str(path or "")))


def normalize_origin(url):
    s = str(url or "").strip()
    if not s:
        return ""
    s = s.rstrip("/")
    for suffix in ("/admin", "/api"):
        if s.lower().endswith(suffix):
            s = s[: -len(suffix)].rstrip("/")
    return s


def parse_allow_insecure(value):
    s = str(value or "0").strip().lower()
    return s in ("1", "true", "yes")


def clean_text(value, limit=MAX_TEXT_CHARS):
    """Bound text from the network or curl before it reaches the panel."""
    if value is None:
        return None
    text = re.sub(r"[\x00-\x1f\x7f]+", " ", str(value)).strip()
    if len(text) > limit:
        text = text[: limit - 1].rstrip() + "…"
    return text


def envelope(state, error=None, ok=None, **fields):
    out = {
        "ok": bool(ok if ok is not None else (state in ("enabled", "paused", "disabled"))),
        "state": state,
        "error": clean_text(error),
        "blocking": False,
        "timer": None,
        "queries": None,
        "gravity": None,
        "history": None,
        "recent_blocked": [],
        "recent_scope": None,
        "updates": None,
        "warnings": None,
        "fetched_at": now_unix(),
    }
    if state == "enabled":
        out["blocking"] = True
    out.update(fields)
    return out


def dumps(obj):
    return json.dumps(obj, ensure_ascii=False, separators=(",", ":"))


def print_json(obj):
    sys.stdout.write(dumps(obj) + "\n")


def usage(msg=None):
    sys.stderr.write((msg + "\n" if msg else "") + USAGE + "\n")
    return 2


def parse_json_body(text):
    raw = (text or "").strip()
    if not raw:
        return {}
    try:
        data = json.loads(raw)
    except ValueError:
        raise FailedError("malformed JSON from Pi-hole") from None
    if data is None:
        return {}
    if not isinstance(data, dict):
        raise FailedError("unexpected JSON from Pi-hole")
    return data


def error_hint(payload):
    err = payload.get("error") if isinstance(payload, dict) else None
    if not isinstance(err, dict):
        return None
    hint = err.get("hint")
    if isinstance(hint, str) and hint.strip():
        return hint.strip()
    message = err.get("message")
    if isinstance(message, str) and message.strip():
        return message.strip()
    key = err.get("key")
    if isinstance(key, str) and key.strip():
        return key.strip()
    return None


def error_key(payload):
    err = payload.get("error") if isinstance(payload, dict) else None
    if isinstance(err, dict):
        return str(err.get("key") or "")
    return ""


def raise_http_error(status, payload, default="request failed"):
    if status == 429:
        raise rate_limited(payload)
    if status == 401:
        raise AuthError(error_hint(payload) or "unauthorized")
    if status is None:
        raise OfflineError(default)
    if status >= 500:
        raise FailedError(error_hint(payload) or ("HTTP %d" % status))
    raise FailedError(error_hint(payload) or ("HTTP %d" % status))


def request(ctx, method, path, body=None, sid=None):
    url = ctx["origin"] + path
    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "application/json",
    }
    if sid:
        headers["X-FTL-SID"] = sid
    status, text, terr = http_exchange(method, url, headers, body, ctx["insecure"], ctx.get("ca_file"))
    if terr:
        raise OfflineError(terr)
    if status == 429:
        # A proxy in front of the Pi-hole may answer 429 with HTML.
        try:
            payload = parse_json_body(text) if text else {}
        except FailedError:
            payload = {}
        raise rate_limited(payload)
    payload = parse_json_body(text) if text else {}
    return status, payload


def _read_owned_regular_file(path, max_bytes=MAX_SECRET_BYTES):
    """Read a secret file through one file descriptor.

    Opens with O_NOFOLLOW so a symlink swapped in after a separate stat()
    can't redirect the read, then validates the *descriptor* (not the path)
    is a regular file owned by us before reading a bounded amount from it.
    Raises OSError, including FileNotFoundError, on any failure.
    """
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError("%s is not a regular file" % path)
        if st.st_uid != os.getuid():
            raise OSError("%s is not owned by the current user" % path)
        data = os.read(fd, max_bytes + 1)
        if len(data) > max_bytes:
            raise OSError("%s is larger than %d bytes" % (path, max_bytes))
        return data, st
    finally:
        os.close(fd)


def read_password_file(path):
    """Return (password_or_None, error_or_None).

    None password means the file is missing. Empty string is an empty file.
    """
    if not path:
        return None, None
    try:
        data, st = _read_owned_regular_file(path)
    except FileNotFoundError:
        return None, None
    except OSError as exc:
        return None, "cannot read password file at %s (%s)" % (path, exc)
    if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        return None, "password file is group/world-readable; chmod 600 %s" % path
    return data.decode("utf-8", "replace").rstrip(" \t\r\n"), None


def read_session(ctx):
    """Return (origin, sid) from the session file, or None.

    A file without an origin (written before sessions were keyed to their
    host) returns None: nothing says which Pi-hole it belongs to.
    """
    try:
        data, _st = _read_owned_regular_file(ctx["session_file"])
    except OSError:
        return None
    try:
        record = json.loads(data.decode("utf-8", "replace"))
    except ValueError:
        return None
    if not isinstance(record, dict):
        return None
    origin = record.get("origin")
    sid = record.get("sid")
    if isinstance(origin, str) and isinstance(sid, str) and SID_RE.match(sid):
        return origin, sid
    return None


def load_sid(ctx):
    if ctx.get("ephemeral"):
        return ctx.get("sid") or ""
    record = read_session(ctx)
    if record and record[0] == ctx["origin"]:
        return record[1]
    return ""


def remove_session_file(ctx):
    try:
        os.remove(ctx["session_file"])
    except OSError:
        pass


def drop_sid(ctx):
    if ctx.get("ephemeral"):
        ctx["sid"] = ""
        return
    remove_session_file(ctx)


def save_sid(ctx, sid):
    if ctx.get("ephemeral"):
        ctx["sid"] = sid or ""
        return
    if not sid:
        drop_sid(ctx)
        return
    directory = os.path.dirname(ctx["session_file"])
    os.makedirs(directory, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix="session.", dir=directory)
    try:
        os.write(fd, (dumps({"origin": ctx["origin"], "sid": sid}) + "\n").encode("utf-8"))
        os.fchmod(fd, 0o600)
        os.close(fd)
        fd = -1
        os.rename(tmp, ctx["session_file"])
        tmp = None
    finally:
        if fd >= 0:
            os.close(fd)
        if tmp and os.path.exists(tmp):
            os.remove(tmp)


def retire_foreign_session(ctx):
    """Log out a session saved for another host there; never send it here."""
    record = read_session(ctx)
    if record and record[0] == ctx["origin"]:
        return
    if record:
        try:
            request(dict(ctx, origin=record[0]), "DELETE", "/api/auth", sid=record[1])
        except HelperError:
            pass
    remove_session_file(ctx)


def replace_sid(ctx, new_sid):
    """DELETE a SID we still hold before installing a different one."""
    old = load_sid(ctx)
    if old and old != new_sid:
        try:
            request(ctx, "DELETE", "/api/auth", sid=old)
        except HelperError:
            pass
    save_sid(ctx, new_sid)


def session_valid(payload):
    session = payload.get("session") if isinstance(payload, dict) else None
    return isinstance(session, dict) and session.get("valid") is True


def session_totp(payload):
    session = payload.get("session") if isinstance(payload, dict) else None
    if isinstance(session, dict):
        return bool(session.get("totp"))
    return False


def session_sid(payload):
    session = payload.get("session") if isinstance(payload, dict) else None
    if not isinstance(session, dict):
        return ""
    sid = session.get("sid")
    return sid if isinstance(sid, str) and SID_RE.match(sid) else ""


def authenticate(ctx, held_sid=""):
    """Establish a session. GET /api/auth, then POST password if needed."""
    status, payload = request(ctx, "GET", "/api/auth", sid=held_sid or None)
    if status == 429:
        raise rate_limited(payload)
    totp = session_totp(payload)
    if status == 200 and session_valid(payload):
        sid = session_sid(payload)
        if sid:
            if held_sid and held_sid != sid:
                replace_sid(ctx, sid)
            else:
                save_sid(ctx, sid)
        elif held_sid:
            drop_sid(ctx)
        return sid

    if status not in (200, 401):
        raise_http_error(status, payload, "auth check failed")

    password, pw_err = read_password_file(ctx["password_file"])
    if pw_err:
        raise AuthError(pw_err)
    if password is None:
        raise AuthError("no password file at %s" % ctx["password_file"])

    if held_sid:
        try:
            request(ctx, "DELETE", "/api/auth", sid=held_sid)
        except HelperError:
            pass
        drop_sid(ctx)

    status, payload = request(ctx, "POST", "/api/auth", body={"password": password})
    if status == 429:
        raise rate_limited(payload)
    totp = totp or session_totp(payload)
    login_failed = (
        status in (400, 401)
        or not session_valid(payload)
        or (status != 200)
    )
    if login_failed:
        key = error_key(payload)
        if totp and (status in (400, 401) or key == "totp_missing"):
            raise AuthError(TWO_FA_MSG)
        raise AuthError("password rejected")
    sid = session_sid(payload)
    if sid:
        save_sid(ctx, sid)
    return sid


def ensure_session(ctx):
    if ctx.get("authed"):
        return
    if not ctx.get("ephemeral"):
        retire_foreign_session(ctx)
    if not load_sid(ctx):
        authenticate(ctx)
    ctx["authed"] = True


def api(ctx, method, path, body=None, retried=False):
    if not retried:
        ensure_session(ctx)
    sid = load_sid(ctx)
    status, payload = request(ctx, method, path, body=body, sid=sid or None)
    if status == 429:
        raise rate_limited(payload)
    if status == 401:
        drop_sid(ctx)
        ctx["authed"] = False
        if retried:
            raise AuthError("unauthorized")
        authenticate(ctx)
        ctx["authed"] = True
        return api(ctx, method, path, body=body, retried=True)
    if status == 204:
        return {}
    if status is None or not 200 <= status < 300:
        raise_http_error(status, payload)
    return payload


def whole(value, default=0, limit=10**15):
    """A non-negative integer from network JSON, or default.

    JSON can carry 1e309 (infinity), NaN or huge values; int() of those
    raises or yields nonsense, so they fall back to the default.
    """
    if isinstance(value, bool) or value is None:
        return default
    try:
        n = float(value)
    except (TypeError, ValueError, OverflowError):
        return default
    if not math.isfinite(n) or n < 0 or n > limit:
        return default
    return int(n)


def map_blocking(payload):
    raw = payload.get("blocking") if isinstance(payload, dict) else None
    timer = payload.get("timer") if isinstance(payload, dict) else None
    if raw is True or raw == "enabled":
        mode = "enabled"
    elif raw is False or raw == "disabled":
        mode = "disabled"
    elif raw in ("failed", "unknown"):
        raise FailedError("blocking %s" % raw)
    else:
        raise FailedError("unexpected blocking status")
    remaining = None
    if isinstance(timer, (int, float)) and not isinstance(timer, bool):
        remaining = whole(timer, None, limit=366 * 86400) or None
    if mode == "enabled":
        return "enabled", True, remaining if remaining else None
    if remaining:
        return "paused", False, remaining
    return "disabled", False, None


def map_queries(payload):
    queries = payload.get("queries") if isinstance(payload, dict) else None
    if not isinstance(queries, dict):
        return None
    def num(key):
        value = queries.get(key)
        if isinstance(value, bool) or value is None:
            return 0
        try:
            n = float(value)
        except (TypeError, ValueError, OverflowError):
            return 0
        return n if math.isfinite(n) and abs(n) <= 1e15 else 0

    return {
        "total": int(num("total")),
        "blocked": int(num("blocked")),
        "percent_blocked": float(num("percent_blocked")),
        "unique_domains": int(num("unique_domains")),
        "frequency": float(num("frequency")),
    }


def map_gravity(payload):
    gravity = payload.get("gravity") if isinstance(payload, dict) else None
    if not isinstance(gravity, dict):
        return None
    domains = gravity.get("domains_being_blocked")
    last = gravity.get("last_update")
    return {
        "domains_being_blocked": whole(domains),
        "last_update": whole(last),
    }


def map_history(payload):
    rows = payload.get("history") if isinstance(payload, dict) else None
    if not isinstance(rows, list):
        return None
    out = []
    for row in rows[-MAX_HISTORY_ROWS:]:
        if not isinstance(row, dict):
            continue
        t_n = whole(row.get("t", row.get("timestamp")), None)
        if t_n is None:
            continue
        out.append({"t": t_n, "total": whole(row.get("total")), "blocked": whole(row.get("blocked"))})
    return out


def map_recent_blocked(payload):
    blocked = payload.get("blocked") if isinstance(payload, dict) else None
    if isinstance(blocked, str):
        blocked = [blocked]
    return plain_domains(blocked)


def map_blocked_queries(payload):
    rows = payload.get("queries") if isinstance(payload, dict) else None
    if not isinstance(rows, list):
        return []
    return plain_domains([row.get("domain") for row in rows if isinstance(row, dict)])


def plain_domains(items):
    if not isinstance(items, list):
        return []
    # Only plain domain names reach the panel and the Allow button.
    out = []
    for item in items:
        domain = normalize_domain(item) if isinstance(item, str) else ""
        if domain and domain not in out:
            out.append(domain)
        if len(out) >= MAX_DOMAINS:
            break
    return out


def collect_status(ctx, full):
    summary = api(ctx, "GET", "/api/stats/summary")
    blocking = api(ctx, "GET", "/api/dns/blocking")
    state, is_blocking, timer = map_blocking(blocking)
    history = None
    recent, scope = [], None
    updates = warnings = None
    if full:
        try:
            history = map_history(api(ctx, "GET", "/api/history"))
        except HelperError as exc:
            stop_on(exc)
            history = None
        recent, scope = recent_blocks(ctx)
        updates = optional(ctx, "/api/info/version", map_updates)
        warnings = optional(ctx, "/api/info/messages/count", map_warning_count)
    return envelope(
        state,
        ok=True,
        error=None,
        blocking=is_blocking,
        timer=timer,
        queries=map_queries(summary),
        gravity=map_gravity(summary),
        history=history if full else None,
        recent_blocked=recent if full else [],
        recent_scope=scope if full else None,
        updates=updates if full else None,
        warnings=warnings if full else None,
    )


def stop_on(exc):
    """A panel extra may fail quietly, except for auth or a rate limit.

    Those end the whole status, so the panel shows setup or the widget
    backs off instead of making more requests into the limit.
    """
    if isinstance(exc, AuthError) or exc.extra.get("rate_limited"):
        raise exc


def optional(ctx, path, mapper):
    """A panel extra: its failure must not fail the status."""
    try:
        return mapper(api(ctx, "GET", path))
    except HelperError as exc:
        stop_on(exc)
        return None


VERSION_RE = re.compile(r"^[A-Za-z0-9._+-]{1,40}$")
COMPONENTS = (("core", "Core"), ("web", "Web interface"), ("ftl", "FTL"))


def map_updates(payload):
    """Components whose installed and latest versions are both known and differ.

    A Docker install is updated by pulling the image, so only the image
    tag is compared there.
    """
    version = payload.get("version") if isinstance(payload, dict) else None
    if not isinstance(version, dict):
        return None

    def known(value):
        return value if isinstance(value, str) and VERSION_RE.match(value) else None

    docker = version.get("docker")
    if isinstance(docker, dict) and known(docker.get("local")) and known(docker.get("remote")):
        pairs = [("Docker image", docker.get("local"), docker.get("remote"))]
    else:
        pairs = []
        for key, name in COMPONENTS:
            part = version.get(key)
            if not isinstance(part, dict):
                continue
            local = part.get("local") if isinstance(part.get("local"), dict) else {}
            remote = part.get("remote") if isinstance(part.get("remote"), dict) else {}
            pairs.append((name, local.get("version"), remote.get("version")))
    out = []
    for name, local, remote in pairs:
        if known(local) and known(remote) and local != remote:
            out.append({"name": name, "local": local, "remote": remote})
    return out


def map_warning_count(payload):
    count = payload.get("count") if isinstance(payload, dict) else None
    if isinstance(count, bool) or not isinstance(count, int) or count < 0:
        return None
    return min(count, 9999)


IP_RE = re.compile(r"^[0-9A-Fa-f:.]{2,45}$")


def recent_blocks(ctx):
    """Blocked domains for this computer, else for the whole network.

    The Pi-hole names the address it sees this computer at. Behind a
    reverse proxy or NAT that is the proxy, whose own queries are few, so
    an empty answer falls back to the network-wide list.
    Returns (domains, "here" | "network" | None).
    """
    try:
        addr = api(ctx, "GET", "/api/info/client").get("remote_addr")
        if isinstance(addr, str) and IP_RE.match(addr):
            path = "/api/queries?upstream=blocklist&length=50&client_ip=" + urllib.parse.quote(addr, safe="")
            here = map_blocked_queries(api(ctx, "GET", path))
            if here:
                return here, "here"
    except HelperError as exc:
        stop_on(exc)
    try:
        network = map_recent_blocked(api(ctx, "GET", "/api/stats/recent_blocked?count=10"))
    except HelperError as exc:
        stop_on(exc)
        return [], None
    return network, "network" if network else None


def collect_ping(ctx):
    # Setup tests draft settings, possibly for another host. Log in with them
    # on a throwaway session, so a stored session can neither leak to that
    # host nor hide a wrong password, and the stored file is left alone.
    # It checks the same endpoints the widget uses: a connection that only
    # reaches the summary would leave a widget that cannot control blocking.
    ctx["ephemeral"] = True
    ctx["sid"] = ""
    try:
        authenticate(ctx)
        ctx["authed"] = True
        return collect_status(ctx, full=False)
    finally:
        if ctx.get("sid"):
            try:
                request(ctx, "DELETE", "/api/auth", sid=ctx["sid"])
            except HelperError:
                pass


def do_pause(ctx, seconds):
    api(ctx, "POST", "/api/dns/blocking", body={"blocking": False, "timer": int(seconds)})
    return collect_status(ctx, full=False)


def do_resume(ctx):
    api(ctx, "POST", "/api/dns/blocking", body={"blocking": True, "timer": None})
    return collect_status(ctx, full=False)


def normalize_domain(value):
    domain = str(value or "").strip().rstrip(".").lower()
    if not DOMAIN_RE.match(domain):
        return ""
    return domain


def add_allow(ctx, domain):
    """Add an exact allow entry. Returns "allowed" or "already".

    Raises FailedError with the Pi-hole's reason when it refuses.
    """
    payload = api(
        ctx,
        "POST",
        "/api/domains/allow/exact",
        body={"domain": domain, "comment": ALLOW_COMMENT, "enabled": True},
    )
    processed = payload.get("processed") if isinstance(payload, dict) else None
    if isinstance(processed, dict):
        errors = processed.get("errors") or []
        success = processed.get("success") or []
        if errors and not success:
            first = errors[0] if isinstance(errors[0], dict) else {}
            message = str(first.get("error") or first.get("message") or "rejected")
            if "unique" in message.lower():
                return "already"
            raise FailedError(message)
    return "allowed"


def do_allow(ctx, domain):
    # An allowlist rejection says nothing about the Pi-hole's health, so it
    # rides along as `action` on a normal status rather than replacing the
    # state with "failed". Auth and offline errors still propagate.
    # The panel words the notice from `code`; `message` is the Pi-hole's
    # reason when it refused.
    try:
        action = {"ok": True, "code": add_allow(ctx, domain), "domain": domain, "message": None}
    except FailedError as exc:
        stop_on(exc)
        action = {"ok": False, "code": "failed", "domain": domain, "message": clean_text(exc.error)}
    result = collect_status(ctx, full=True)
    result["action"] = action
    return result


def build_ctx(env):
    origin = normalize_origin(env.get("OMAPIHOLE_URL", ""))
    password_file = expand_path(env.get("OMAPIHOLE_PASSWORD_FILE") or DEFAULT_PASSWORD_FILE)
    ca_raw = str(env.get("OMAPIHOLE_CA_FILE") or "").strip()
    return {
        "ca_file": expand_path(ca_raw) if ca_raw else "",
        "origin": origin,
        "password_file": password_file,
        "insecure": parse_allow_insecure(env.get("OMAPIHOLE_ALLOW_INSECURE")),
        "session_file": session_path(env),
        "env": env,
    }


def with_lock(env, fn):
    directory = state_dir(env)
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        fd = os.open(lock_path(env), os.O_CREAT | os.O_RDWR, 0o600)
    except OSError as exc:
        raise FailedError("cannot write session state (%s)" % exc) from exc
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fn()
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        except OSError:
            pass
        os.close(fd)


def dispatch(argv, env):
    args = list(argv[1:])
    command = args[0]
    rest = args[1:]
    ctx = build_ctx(env)

    _, pw_err = read_password_file(ctx["password_file"])
    if pw_err:
        raise AuthError(pw_err)
    # The CA file only matters for HTTPS with verification on.
    if (ctx["ca_file"] and not ctx["insecure"] and ctx["origin"].lower().startswith("https://")
            and not os.path.isfile(ctx["ca_file"])):
        raise FailedError("no CA certificate file at %s" % ctx["ca_file"])

    if command == "status":
        full = True
        if rest == ["--bar"]:
            full = False
        elif rest:
            raise SystemExit(usage("unknown status argument"))
        return collect_status(ctx, full)
    if command == "ping":
        if rest:
            raise SystemExit(usage("ping takes no arguments"))
        return collect_ping(ctx)
    if command == "pause":
        if len(rest) != 1:
            raise SystemExit(usage("pause requires seconds"))
        try:
            seconds = int(rest[0])
        except ValueError:
            raise SystemExit(usage("pause seconds must be an integer")) from None
        if seconds <= 0:
            raise SystemExit(usage("pause seconds must be > 0"))
        return do_pause(ctx, seconds)
    if command == "resume":
        if rest:
            raise SystemExit(usage("resume takes no arguments"))
        return do_resume(ctx)
    if command == "allow":
        if len(rest) != 1:
            raise SystemExit(usage("allow requires one domain"))
        domain = normalize_domain(rest[0])
        if not domain:
            raise SystemExit(usage("allow needs a plain domain name"))
        return do_allow(ctx, domain)
    raise SystemExit(usage("unknown command"))


def run(argv, env):
    args = list(argv[1:])
    if not args or args[0] in ("-h", "--help"):
        raise SystemExit(usage())
    origin = normalize_origin(env.get("OMAPIHOLE_URL", ""))
    if not origin:
        print_json(envelope("unconfigured", error="empty url"))
        return 0
    # A path is kept: a reverse proxy may serve the API under a prefix.
    if not re.match(r"^https?://[^/?#\s]+(/[^?#\s]*)?$", origin, re.IGNORECASE):
        print_json(envelope("failed", error="URL must start with http:// or https:// and name a host"))
        return 0
    try:
        result = with_lock(env, lambda: dispatch(argv, env))
    except AuthError as exc:
        result = envelope("auth", error=str(exc))
    except OfflineError as exc:
        result = envelope("offline", error=str(exc))
    except FailedError as exc:
        result = envelope("failed", error=str(exc), **exc.extra)
    print_json(result)
    return 0


def main():
    return run(sys.argv, os.environ)


if __name__ == "__main__":
    sys.exit(main())
